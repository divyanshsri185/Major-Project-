PORT=3000
# REQUIRED in production: long random string
JWT_SECRET=replace-with-a-long-random-secret
# People who register with this code become examiners. Leave empty to disable.
EXAMINER_INVITE_CODE=
# Seeded examiner account (created on first run if no examiner exists)
ADMIN_EMAIL=examiner@invigil.local
ADMIN_PASSWORD=replace-with-a-strong-password
DB_PATH=./data/invigil.db
